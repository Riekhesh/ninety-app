# ─────────────────────────────────────────────────────────────────────────────
# Notch — local tooling environment
#
#   cp .env.example .env    then fill in .env, which is gitignored.
#
# NOTHING in here belongs in the iOS app. The app never holds a model API key
# or a service_role key — see docs/security/secrets.md. These values are for
# local scripts (the Phase 0 vision spike) and for running migrations.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spike B: vision accuracy benchmark (§0.7) ───────────────────────────────
# Only ONE of these is needed. Gemini is the default (ADR 0010).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# The model is recorded in every run manifest, so a measured error rate is
# reproducible and attributable to a specific version. Override per run with
# --model rather than editing this.
#
# Anthropic gotcha if you switch: `temperature` is REJECTED with a 400 on
# claude-opus-5, not ignored. Do not add one.
NOTCH_VISION_MODEL=gemini-3.5-flash-lite

# ── Supabase (Phase 1 onward) ───────────────────────────────────────────────
# The anon key is public by design and ships in the app bundle; RLS is what
# actually protects the data. The service_role key bypasses RLS entirely —
# treat it like a root password and never put it near the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── PostHog (Phase 3 onward) ────────────────────────────────────────────────
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
