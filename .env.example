# ─────────────────────────────────────────────────────────────────────────────
# Notch — local tooling environment
#
#   cp .env.example .env    then fill in .env, which is gitignored.
#
# NOTHING in here belongs in the iOS app. The app never holds a model API key
# or a service_role key — see docs/security/secrets.md. These values are for
# local scripts (the Phase 0 vision spike) and for running migrations.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spike B: vision accuracy baseline (§0.7) ────────────────────────────────
# Only one provider is needed. Anthropic is the default (see ADR 0009).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model used for the baseline. Recorded in the run manifest so the measured
# error rate is reproducible and attributable to a specific model version.
# Note: do NOT add a temperature setting — it is rejected (400) on this model.
NOTCH_VISION_MODEL=claude-opus-5

# ── Supabase (Phase 1 onward) ───────────────────────────────────────────────
# The anon key is public by design and ships in the app bundle; RLS is what
# actually protects the data. The service_role key bypasses RLS entirely —
# treat it like a root password and never put it near the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── PostHog (Phase 3 onward) ────────────────────────────────────────────────
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
