{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Ninety design tokens. Visual world: MATCHDAY — a lit football pitch. Dark is the default appearance; light is the same world at midday. Generated to Swift and CSS by generate.py, which validates every text/surface pair against WCAG AA and refuses a failing one.",
  "_meta": {
    "version": "1.0.0",
    "direction": "Quiet premium, dark-first (ADR 0011)",
    "contrastPolicy": "Every text-on-surface pair below carries its measured WCAG 2.1 contrast ratio. Text tokens meet AA (4.5:1) at body size; tokens that do not are named and scoped explicitly.",
    "colourBudget": "Tier metals are the only saturated colour in the product. Semantic colours are rationed to state, safety, and destruction. See design/spec/00-design-principles.md (principle 2)."
  },
  "theme": {
    "dark": {
      "$type": "color",
      "$description": "Default theme. Warm graphite ramp (hue ~30 degrees, very low saturation) rather than neutral-cool — see ADR 0011 for why.",
      "canvas": {
        "$value": "#08210F",
        "$description": "The pitch under floodlight. Deep, warm-shifted green — never neutral black."
      },
      "surface": {
        "$value": "#0C2B18",
        "$description": "Cards and rows: the pitch one mow-stripe lighter."
      },
      "surfaceRaised": {
        "$value": "#11351E",
        "$description": "Sheets and anything lifted off the pitch."
      },
      "surfaceSunken": {
        "$value": "#04120B",
        "$description": "Inset wells: chart grounds, the tab bar, input fields."
      },
      "stroke": {
        "$value": "#2A4A35",
        "$description": "Faint chalk. Dividers inside a panel."
      },
      "strokeStrong": {
        "$value": "#B9CFC0",
        "$description": "Chalk. Panel edges and the mastheads, drawn at 2px."
      },
      "textPrimary": {
        "$value": "#F2EFE6",
        "$description": "Chalk white, very slightly warm. All data and headlines."
      },
      "textSecondary": {
        "$value": "#B6CCBC",
        "$description": "Supporting copy and row subtitles."
      },
      "textTertiary": {
        "$value": "#9FBBA8",
        "$description": "Condensed micro-labels — the broadcast caption voice."
      },
      "textDisabled": {
        "$value": "#628070",
        "$description": "Placeholder and unavailable."
      },
      "textInverse": {
        "$value": "#08210F",
        "$description": "On gold: the KICK OFF and GIVE THE DECISION buttons."
      },
      "accent": {
        "$value": "#E8B54A",
        "$description": "Division gold. Tier identity, the target band, the primary action. Reserved — never decoration."
      },
      "accentPressed": {
        "$value": "#D2A139",
        "$description": "Gold, pressed."
      },
      "accentSubtle": {
        "$value": "#1A2E1A",
        "$description": "Gold at page scale: the tinted leader row and division strip."
      },
      "positive": {
        "$value": "#7FD6A0",
        "$description": "Confirmations and sync. Never used to reward faster loss (S3)."
      },
      "safety": {
        "$value": "#E8B54A",
        "$description": "§10 interventions only — floor, rate ceiling, goal-weight refusal. Shares gold's hue deliberately: on this surface a safety notice reads as the app's own voice, not an alarm."
      },
      "critical": {
        "$value": "#E0705A",
        "$description": "Destructive confirmation only. There is still no error colour for logged intake."
      },
      "chartLine": {
        "$value": "#F2EFE6",
        "$description": "The trend line. Primary data wears the primary ink, not the accent."
      },
      "chartBaseline": {
        "$value": "#8FA894",
        "$description": "The dashed four-week mark."
      },
      "chartBand": {
        "$value": "#2E3A1E",
        "$description": "Goal-corridor fill — the pace you signed up for."
      },
      "chartGrid": {
        "$value": "#1B3A26",
        "$description": "Mow stripes and grid."
      },
      "chartRaw": {
        "$value": "#4A6B55",
        "$description": "Raw dailies, behind the off-by-default switch."
      }
    },
    "light": {
      "$type": "color",
      "$description": "Full parity, built from day one. Metals are darkened to stay legible on a light ground; the chevron count carries tier identity either way (ADR 0012).",
      "canvas": {
        "$value": "#F1F4EC",
        "$description": "Warm off-white."
      },
      "surface": {
        "$value": "#FFFFFF"
      },
      "surfaceRaised": {
        "$value": "#FFFFFF",
        "$description": "Same fill as surface; elevation on light comes from the shadow token, not a lightness step."
      },
      "surfaceSunken": {
        "$value": "#E3EADE"
      },
      "stroke": {
        "$value": "#CBD9CD"
      },
      "strokeStrong": {
        "$value": "#2E5A3C"
      },
      "textPrimary": {
        "$value": "#0B2416",
        "$description": "17.6:1 on canvas."
      },
      "textSecondary": {
        "$value": "#3D5C48",
        "$description": "7.9:1 on canvas."
      },
      "textTertiary": {
        "$value": "#4A6B55",
        "$description": "4.7:1 on canvas, 4.9:1 on white surface."
      },
      "textDisabled": {
        "$value": "#7A9184",
        "$description": "2.6:1 — disabled controls only."
      },
      "textInverse": {
        "$value": "#FFFFFF"
      },
      "accent": {
        "$value": "#8A6410",
        "$description": "5.4:1 on canvas."
      },
      "accentPressed": {
        "$value": "#6F4F0B"
      },
      "accentSubtle": {
        "$value": "#F5EBD4"
      },
      "positive": {
        "$value": "#1B7A4B"
      },
      "safety": {
        "$value": "#8A6410"
      },
      "critical": {
        "$value": "#A6321C"
      },
      "chartLine": {
        "$value": "#0B2416"
      },
      "chartBaseline": {
        "$value": "#5E7A68"
      },
      "chartBand": {
        "$value": "#E4EFD8"
      },
      "chartGrid": {
        "$value": "#DCE7DD"
      },
      "chartRaw": {
        "$value": "#93A897"
      }
    }
  },
  "tier": {
    "$type": "color",
    "$description": "The only saturated colour in the product (ADR 0011). Colour is the SECONDARY signal — chevron count is primary (ADR 0012), which is what makes Silver/Platinum and Platinum/Diamond distinguishable at all, and what makes the ladder legible without colour vision.",
    "bronze": {
      "$value": "#C07A44",
      "$description": "1 chevron. Starting out.",
      "$extensions": {
        "ninety.count": 1,
        "ninety.light": "#7E4A1E"
      }
    },
    "silver": {
      "$value": "#BFC7C2",
      "$description": "2 chevrons.",
      "$extensions": {
        "ninety.count": 2,
        "ninety.light": "#5C6B62"
      }
    },
    "gold": {
      "$value": "#E8B54A",
      "$description": "3 chevrons. The division the mockups sit in.",
      "$extensions": {
        "ninety.count": 3,
        "ninety.light": "#8A6410"
      }
    },
    "platinum": {
      "$value": "#DCE6E2",
      "$description": "4 chevrons.",
      "$extensions": {
        "ninety.count": 4,
        "ninety.light": "#5F7168"
      }
    },
    "diamond": {
      "$value": "#8FE0D6",
      "$description": "5 chevrons.",
      "$extensions": {
        "ninety.count": 5,
        "ninety.light": "#1B7A70"
      }
    }
  },
  "type": {
    "$description": "Every style maps to an iOS text style so Dynamic Type works without extra code — non-negotiable for a health app. Sizes are the default (Large) sizes; they scale. Metric styles use tabular figures so digits do not jitter as values change.",
    "display": {
      "$type": "typography",
      "$value": {
        "fontSize": "40",
        "lineHeight": "44",
        "fontWeight": "600",
        "letterSpacing": "-0.5"
      },
      "$extensions": {
        "ninety.iosTextStyle": "largeTitle",
        "ninety.usage": "Onboarding step headings, rank tier name."
      }
    },
    "title1": {
      "$type": "typography",
      "$value": {
        "fontSize": "28",
        "lineHeight": "34",
        "fontWeight": "600",
        "letterSpacing": "-0.3"
      },
      "$extensions": {
        "ninety.iosTextStyle": "title"
      }
    },
    "title2": {
      "$type": "typography",
      "$value": {
        "fontSize": "22",
        "lineHeight": "28",
        "fontWeight": "600",
        "letterSpacing": "-0.2"
      },
      "$extensions": {
        "ninety.iosTextStyle": "title2"
      }
    },
    "title3": {
      "$type": "typography",
      "$value": {
        "fontSize": "20",
        "lineHeight": "25",
        "fontWeight": "600",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "title3"
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontSize": "17",
        "lineHeight": "22",
        "fontWeight": "600",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "headline",
        "ninety.usage": "Food name in a row, card titles."
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "17",
        "lineHeight": "22",
        "fontWeight": "400",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "body"
      }
    },
    "callout": {
      "$type": "typography",
      "$value": {
        "fontSize": "16",
        "lineHeight": "21",
        "fontWeight": "400",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "callout"
      }
    },
    "subhead": {
      "$type": "typography",
      "$value": {
        "fontSize": "15",
        "lineHeight": "20",
        "fontWeight": "400",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "subheadline",
        "ninety.usage": "Brand and portion under a food name."
      }
    },
    "footnote": {
      "$type": "typography",
      "$value": {
        "fontSize": "13",
        "lineHeight": "18",
        "fontWeight": "400",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "footnote"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "12",
        "lineHeight": "16",
        "fontWeight": "400",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "caption"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontSize": "11",
        "lineHeight": "14",
        "fontWeight": "600",
        "letterSpacing": "0.6"
      },
      "$extensions": {
        "ninety.iosTextStyle": "caption2",
        "ninety.transform": "uppercase",
        "ninety.usage": "Section eyebrows, stat card labels."
      }
    },
    "metricXL": {
      "$type": "typography",
      "$value": {
        "fontSize": "56",
        "lineHeight": "58",
        "fontWeight": "600",
        "letterSpacing": "-1.5"
      },
      "$extensions": {
        "ninety.iosTextStyle": "largeTitle",
        "ninety.tabularFigures": true,
        "ninety.usage": "The composite score on the rank screen. One per screen, maximum."
      }
    },
    "metricL": {
      "$type": "typography",
      "$value": {
        "fontSize": "40",
        "lineHeight": "44",
        "fontWeight": "600",
        "letterSpacing": "-0.8"
      },
      "$extensions": {
        "ninety.iosTextStyle": "title",
        "ninety.tabularFigures": true,
        "ninety.usage": "Calories remaining."
      }
    },
    "metricM": {
      "$type": "typography",
      "$value": {
        "fontSize": "28",
        "lineHeight": "32",
        "fontWeight": "600",
        "letterSpacing": "-0.3"
      },
      "$extensions": {
        "ninety.iosTextStyle": "title2",
        "ninety.tabularFigures": true
      }
    },
    "metricS": {
      "$type": "typography",
      "$value": {
        "fontSize": "17",
        "lineHeight": "22",
        "fontWeight": "600",
        "letterSpacing": "0"
      },
      "$extensions": {
        "ninety.iosTextStyle": "headline",
        "ninety.tabularFigures": true,
        "ninety.usage": "kcal on a food row."
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4-point grid, with a 2 for optical hairline gaps. If a value you need is not here, the layout is probably wrong.",
    "hair": {
      "$value": "2"
    },
    "xs": {
      "$value": "4"
    },
    "sm": {
      "$value": "8"
    },
    "md": {
      "$value": "12"
    },
    "lg": {
      "$value": "16",
      "$description": "Default screen gutter and card padding."
    },
    "xl": {
      "$value": "20"
    },
    "xxl": {
      "$value": "24"
    },
    "xxxl": {
      "$value": "32"
    },
    "huge": {
      "$value": "48"
    },
    "vast": {
      "$value": "64",
      "$description": "Above the hero metric on the rank screen. Whitespace is the drama budget."
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Always paired with iOS continuous corner curve — the generated Swift helper applies style: .continuous so it cannot be forgotten.",
    "none": {
      "$value": "0"
    },
    "sm": {
      "$value": "8",
      "$description": "Chips, confidence pills, small controls."
    },
    "md": {
      "$value": "12",
      "$description": "Inputs, food rows."
    },
    "lg": {
      "$value": "16",
      "$description": "Cards, stat cards, chart containers."
    },
    "xl": {
      "$value": "24",
      "$description": "Sheets, the hero rank card."
    },
    "full": {
      "$value": "999",
      "$description": "Pills and the primary button."
    }
  },
  "border": {
    "$type": "dimension",
    "hairline": {
      "$value": "1"
    },
    "focus": {
      "$value": "2",
      "$description": "Keyboard/VoiceOver focus ring. Always visible, never removed."
    }
  },
  "motion": {
    "$description": "MOTION BUDGET: nothing except the weekly rank reveal may exceed 0.3s. Enforced by review, not by code — the token names make a violation obvious in a diff. All motion must be gated on the Reduce Motion accessibility setting.",
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "120ms",
        "$description": "Press feedback, chip toggle."
      },
      "fast": {
        "$value": "200ms",
        "$description": "Row insert, toast in."
      },
      "base": {
        "$value": "300ms",
        "$description": "Sheet present, tab change. The ceiling for everything routine."
      },
      "reveal": {
        "$value": "900ms",
        "$description": "THE RANK REVEAL, and nothing else. This is the retention moment (§2.2) and the only place the app is allowed to be theatrical."
      }
    },
    "spring": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$extensions": {
          "ninety.swiftUI": "spring(response: 0.35, dampingFraction: 0.86)"
        }
      },
      "reveal": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$extensions": {
          "ninety.swiftUI": "spring(response: 0.62, dampingFraction: 0.70)",
          "ninety.note": "Slight overshoot. Deliberate — this is the one place a bounce is earned."
        }
      }
    }
  },
  "elevation": {
    "$description": "Dark mode has no shadows; elevation is a surface lightness step plus a hairline stroke. Light mode uses real shadows. The generated Swift helper picks the right treatment per colour scheme so a view cannot get it wrong.",
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#00000029",
        "offsetX": "0",
        "offsetY": "1",
        "blur": "3",
        "spread": "0"
      },
      "$extensions": {
        "ninety.darkTreatment": "surface + stroke hairline, no shadow"
      }
    },
    "sheet": {
      "$type": "shadow",
      "$value": {
        "color": "#00000033",
        "offsetX": "0",
        "offsetY": "8",
        "blur": "24",
        "spread": "0"
      },
      "$extensions": {
        "ninety.darkTreatment": "surfaceRaised + stroke hairline, no shadow"
      }
    }
  },
  "_variants": {
    "$description": "Not generated. Kept for one-line reversal of the ADR 0011 warmth decision if the warm ramp reads badly on a real device.",
    "coolNeutralRamp": {
      "canvas": "#0B0B0D",
      "surface": "#16161A",
      "surfaceRaised": "#1E1E24",
      "stroke": "#2A2A31",
      "strokeStrong": "#3A3A44",
      "textPrimary": "#F4F4F5",
      "textSecondary": "#A1A1AA",
      "textTertiary": "#7E7E88"
    }
  }
}
